# Copy this file to .env and fill with real values (DO NOT commit .env)
NODE_ENV=development
PORT=3100
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,http://localhost:19006

# Database (Postgres / Neon)
# Either provide DATABASE_URL or the DB_* vars below
# DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"
DB_HOST=your_db_host
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_SSL=true

# Redis
REDIS_HOST=your_redis_host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_TLS=false

# JWT / security
JWT_SECRET=replace_with_a_very_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
PAYMENT_WEBHOOK_SECRET=replace_with_webhook_secret

# Payment/Third-party placeholders
# Bascule globale Sandbox / Production des paiements (LigdiCash, CinetPay...)
PAYMENT_ENV=sandbox
# Provider actif : 'mock' (simulation, aucune clé requise) | 'ligdicash' | 'cinetpay' | 'wave'
PAYMENT_PROVIDER=mock
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
LIGDICASH_API_KEY=
LIGDICASH_AUTH_TOKEN=
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=

# Application urls
APP_WEBHOOK_URL=
APP_RETURN_URL=

# Commission
FASOFREE_COMMISSION_RATE=0.0085
FASOFREE_COMMISSION_PAYER=CLIENT

# --- STOCKAGE CLOUD (AWS S3 / Cloudflare R2 / DO Spaces) ---
AWS_S3_BUCKET=fasofree-media-prod
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# Optionnel: CDN personnalisé (ex: Cloudfront) ou Endpoint personnalisé pour R2/DO Spaces
AWS_S3_CDN_URL=https://cdn.fasofree.com
# AWS_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# --- FIREBASE CLOUD MESSAGING (PUSH NOTIFICATIONS) ---
FIREBASE_PROJECT_ID=fasofree-app-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@fasofree-app-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# --- REVERSEMENTS / PAYOUTS MOBILE MONEY ---
# Clefs API CinetPay Transfert / Wave Payout
CINETPAY_PAYOUT_KEY=your_cinetpay_payout_key
CINETPAY_PAYOUT_SECRET=your_cinetpay_payout_secret
PAYOUT_MIN_AMOUNT_FCFA=1000
# --- MONITORING & CAPTURE D'ERREURS (SENTRY) ---
SENTRY_DSN=https://your_sentry_dsn_key@o0.ingest.sentry.io/000000
SENTRY_ENVIRONMENT=production
# --- FIREBASE CLOUD MESSAGING (PUSH NOTIFICATIONS) — voir ci-dessus ---