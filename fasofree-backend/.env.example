# =============================================================================
# FASOFREE BACKEND — .env.example
# =============================================================================
# Copy this file to .env or .env.local and fill with real values.
# NEVER commit .env or .env.local to version control.
# =============================================================================

# --- GENERAL ---
NODE_ENV=development
PORT=3100

# --- DATABASE (Neon PostgreSQL) ---
# Option 1 (recommended): Full connection URL
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Option 2: Individual params (fallback)
DB_HOST=your_db_host
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_SSL=true

# --- REDIS (Upstash) ---
# Option 1: Full URL
REDIS_URL="rediss://default:password@host:6379"
# Option 2: Individual params
REDIS_HOST=your_redis_host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_TLS=true
# Upstash REST API (optional, for REST-based operations)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- JWT / SECURITY ---
JWT_SECRET=replace_with_a_very_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
PAYMENT_WEBHOOK_SECRET=replace_with_webhook_secret

# --- PAYMENT PROVIDERS ---
# Provider: 'mock' (simulation) | 'ligdicash' | 'cinetpay' | 'wave'
PAYMENT_PROVIDER=mock
PAYMENT_ENV=sandbox

# CinetPay (UEMOA / XOF)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2

# LigdiCash
LIGDICASH_API_KEY=
LIGDICASH_AUTH_TOKEN=
LIGDICASH_PLATFORM=sandbox
LIGDICASH_PAYOUT_TOKEN=
LIGDICASH_WEBHOOK_URL=

# Orange SMS
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER_NAME=FasoFree

# Application URLs
APP_WEBHOOK_URL=
APP_RETURN_URL=

# --- FINANCIAL CONFIGURATION ---
FASOFREE_COMMISSION_RATE=0.0085
FASOFREE_COMMISSION_PAYER=CLIENT

# --- CLOUD STORAGE (Cloudinary — PRIORITY) ---
# If configured, Cloudinary takes priority over S3 and local storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- CLOUD STORAGE (S3 / Cloudflare R2 — fallback) ---
AWS_S3_BUCKET=
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_CDN_URL=
# AWS_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# --- FIREBASE CLOUD MESSAGING (Push Notifications) ---
# Option 1: Full service account JSON string
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Option 2: Individual fields (fallback)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- NOTIFICATIONS (Email / WhatsApp) ---
# Gmail SMTP (primary — tested)
SMTP_USER=
SMTP_PASS=
# Resend (fallback if SMTP not configured)
RESEND_API_KEY=
RESEND_FROM_EMAIL=FasoFree <onboarding@resend.dev>

# WhatsApp (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=fasofree_webhook_secret_2026

# SMS (fallback)
SMS_PROVIDER=fallback

# --- PAYOUTS / REVERSALS ---
CINETPAY_PAYOUT_KEY=
CINETPAY_PAYOUT_SECRET=
PAYOUT_MIN_AMOUNT_FCFA=1000

# --- MONITORING (Sentry) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
