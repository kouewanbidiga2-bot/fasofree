# =============================================================================
# FASOFREE BACKEND — .env.example
# =============================================================================
# Copy this file to .env or .env.local and fill with real values.
# NEVER commit .env or .env.local to version control.
# =============================================================================

# --- GENERAL ---
NODE_ENV=development
PORT=3100
# Origines CORS autorisées en production (séparées par des virgules).
CORS_ORIGIN="https://fasofree.site,https://admin.fasofree.site"

# --- DATABASE (Neon PostgreSQL) ---
# synchronize est TOUJOURS désactivé en production (imposé par le code).
# En production, les migrations gèrent le schéma (DB_MIGRATIONS_RUN=true).
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false
# Option 1 (recommended): Full connection URL
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Option 2: Individual params (fallback)
DB_HOST=your_db_host
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_SSL=true

# --- REDIS (Upstash) ---
# Option 1: Full URL
REDIS_URL="rediss://default:password@host:6379"
# Option 2: Individual params
REDIS_HOST=your_redis_host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_TLS=true
# Upstash REST API (optional, for REST-based operations)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- JWT / SECURITY ---
JWT_SECRET=replace_with_a_very_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
PAYMENT_WEBHOOK_SECRET=replace_with_webhook_secret

# --- RATE LIMITING (par IP) ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# --- PAYMENT PROVIDERS ---
# GeniusPay est le SEUL provider de paiement (Orange Money, Moov Money, Wave).
PAYMENT_ENV=sandbox

# GeniusPay (OBLIGATOIRE)
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
# OBLIGATOIRE en production — sinon les webhooks de paiement sont rejetés
GENIUSPAY_WEBHOOK_SECRET=

# Orange SMS
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER_NAME=FasoFree

# Application URLs
APP_WEBHOOK_URL=
APP_RETURN_URL=

# --- FINANCIAL CONFIGURATION ---
FASOFREE_COMMISSION_RATE=0.0085
FASOFREE_COMMISSION_PAYER=CLIENT

# --- CLOUD STORAGE (Cloudinary — PRIORITY) ---
# If configured, Cloudinary takes priority over S3 and local storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- CLOUD STORAGE (S3 / Cloudflare R2 — fallback) ---
AWS_S3_BUCKET=
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_CDN_URL=
# AWS_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# --- FIREBASE CLOUD MESSAGING (Push Notifications) ---
# Option 1 (recommended): Full service account JSON — colle le CONTENU COMPLET du
# fichier service account (toute la chaîne JSON sur UNE seule ligne, private_key incluse).
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option 2: Individual fields (fallback)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- NOTIFICATIONS (Email / WhatsApp) ---
# Gmail SMTP (primary — tested)
SMTP_USER=
SMTP_PASS=
# Resend (fallback if SMTP not configured)
RESEND_API_KEY=
RESEND_FROM_EMAIL=FasoFree <onboarding@resend.dev>
# Expéditeur final + Reply-To (les réponses clients arrivent sur la boîte pro)
EMAIL_FROM=FasoFree <noreply@fasofree.site>
EMAIL_REPLY_TO=fasofree2@gmail.com

# WhatsApp (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Jeton de vérification (GET) — OBLIGATOIRE, aucune valeur par défaut
WHATSAPP_VERIFY_TOKEN=
# App Secret Meta pour vérifier X-Hub-Signature-256 des événements (POST)
WHATSAPP_APP_SECRET=

# Gemini AI (import catalogue depuis PDF)
# Clé API gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# SMS (fallback multi-canal du dispatcher)
# Valeurs possibles : fallback (dev — log uniquement, aucun SMS réel)
#                    | twilio | africastalking
SMS_PROVIDER=fallback
# Twilio (si SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+226XXXXXXXXX
# Africa's Talking (si SMS_PROVIDER=africastalking)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=FasoFree

# --- PAYOUTS / REVERSALS ---
PAYOUT_MIN_AMOUNT_FCFA=1000

# --- MONITORING (Sentry) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
