# =============================================================================
# FASOFREE BACKEND — .env.production.example
# -----------------------------------------------------------------------------
# À utiliser en production sur le VPS (Oracle Cloud / Hostinger).
# Copie ce fichier vers /opt/fasofree-backend/.env puis remplis les valeurs
# réelles (elles viennent de ton ancien dashboard Render, sauf PORT et CORS).
# =============================================================================

# --- GENERAL ---
NODE_ENV=production
PORT=3100
# Origines CORS autorisées (séparées par des virgules). Ajoute ton domaine.
CORS_ORIGIN="https://fasofree-admin.onrender.com,https://fasofree-client.onrender.com,https://admin.fasofree.site"

# --- DATABASE (Neon PostgreSQL — inchangé) ---
# synchronize est TOUJOURS désactivé en production (imposé par le code).
# Les migrations s'exécutent au boot (DB_MIGRATIONS_RUN=true).
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Option 2: Individual params (fallback)
# DB_HOST=your_db_host
# DB_PORT=5432
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_NAME=your_db_name
# DB_SSL=true

# --- REDIS (Upstash — inchangé) ---
REDIS_URL="rediss://default:password@host:6379"
# REDIS_HOST=your_redis_host
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password
# REDIS_TLS=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- JWT / SECURITY ---
JWT_SECRET=replace_with_the_same_secret_used_in_render
JWT_EXPIRES_IN=7d
PAYMENT_WEBHOOK_SECRET=replace_with_webhook_secret

# --- RATE LIMITING (par IP) ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# --- PAYMENT PROVIDERS ---
PAYMENT_PROVIDER=mock
PAYMENT_ENV=sandbox

# CinetPay
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2

# LigdiCash
LIGDICASH_API_KEY=
LIGDICASH_AUTH_TOKEN=
LIGDICASH_PLATFORM=sandbox
LIGDICASH_PAYOUT_TOKEN=
LIGDICASH_WEBHOOK_URL=

# PayDunya
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=sandbox
PAYDUNYA_WEBHOOK_URL=

# GeniusPay
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=

# Orange SMS
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER_NAME=FasoFree

# Application URLs — pointe vers le NOUVEAU backend
APP_WEBHOOK_URL=https://api.fasofree.site/api/v1
APP_RETURN_URL=

# --- FINANCIAL CONFIGURATION ---
FASOFREE_COMMISSION_RATE=0.0085
FASOFREE_COMMISSION_PAYER=CLIENT

# --- CLOUD STORAGE (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- CLOUD STORAGE (S3 / Cloudflare R2) ---
AWS_S3_BUCKET=
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_CDN_URL=

# --- FIREBASE CLOUD MESSAGING ---
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# --- NOTIFICATIONS (Email / WhatsApp) ---
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
RESEND_FROM_EMAIL=FasoFree <onboarding@resend.dev>
EMAIL_FROM=FasoFree <noreply@fasofree.site>
EMAIL_REPLY_TO=fasofree2@gmail.com

# WhatsApp (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# SMS
SMS_PROVIDER=fallback

# --- PAYOUTS / REVERSALS ---
CINETPAY_PAYOUT_KEY=
CINETPAY_PAYOUT_SECRET=
PAYOUT_MIN_AMOUNT_FCFA=1000

# --- MONITORING (Sentry) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production