# =============================================================================
# FASOFREE ADMIN DASHBOARD — .env.example
# =============================================================================
# Copy this file to .env and fill with real values.
# NEVER commit .env to version control.
# =============================================================================

# --- API BACKEND ---
VITE_API_URL=https://api.fasofree.site/api/v1

# --- SUPPORT (hotline) ---
# Numéro de la hotline FasoFree (format international, ex. +22670000000).
# S'il est vide ou absent, les boutons « Appeler le support » sont masqués.
# NB : les variables VITE_* sont inlinées au build — modifier la valeur sur
# l'hébergeur exige un REBUILD, pas un simple redeploy.
# Référence actuelle : le Footer affiche +226 61 01 00 11 tant que cette
# variable est vide (une seule source de vérité à terme).
# VITE_SUPPORT_PHONE=+22670000000

# =============================================================================
# 🔔 NOTIFICATIONS PUSH (FCM) — DÉSACTIVÉ, NE PAS ACTIVER AU LANCEMENT
# =============================================================================
# Tant que VITE_PUSH_ENABLED n'est PAS exactement "true", le navigateur
# n'est jamais sollicité : aucune permission demandée, aucun appel réseau.
# Les campagnes passent aujourd'hui par EMAIL / SMS / WhatsApp, ce qui
# fonctionne sans application mobile.
#
# Pour activer le push le jour venu (à faire UNIQUEMENT quand l'app mobile
# sera prête — le flag est inliné au build, donc REBUILD obligatoire) :
#   1. npm install firebase
#   2. créer public/firebase-messaging-sw.js (config publique Firebase)
#   3. renseigner les variables ci-dessous
#   4. VITE_PUSH_ENABLED="true"
#
# VITE_PUSH_ENABLED=false
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=
