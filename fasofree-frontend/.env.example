# =============================================================================
# FASOFREE ADMIN DASHBOARD — .env.example
# =============================================================================
# Copy this file to .env and fill with real values.
# NEVER commit .env to version control.
# =============================================================================

# --- API BACKEND ---
VITE_API_URL=https://api.fasofree.site/api/v1

# --- SUPPORT (hotline) ---
# Numéro de la hotline FasoFree (format international, ex. +22670000000).
# S'il est vide ou absent, les boutons « Appeler le support » sont masqués.
# NB : les variables VITE_* sont inlinées au build — modifier la valeur sur
# l'hébergeur exige un REBUILD, pas un simple redeploy.
# Référence actuelle : le Footer affiche +226 61 01 00 11 tant que cette
# variable est vide (une seule source de vérité à terme).
# VITE_SUPPORT_PHONE=+22670000000
